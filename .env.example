# Required. Get this from https://console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# --- Web app only (ignored by the CLI) ------------------------------------ #

# Required in any deployment. Gates the whole UI behind HTTP Basic auth so the
# endpoint cannot be used by strangers to spend your Anthropic credits.
APP_PASSWORD=
APP_USERNAME=ten

# Set to 1 to deliberately run without a password (local development only).
ALLOW_ANONYMOUS=

# --- Email notifications (Resend) ----------------------------------------- #

# Set to enable emailing every finished analysis. Leave blank to disable.
# Key from https://resend.com/api-keys
RESEND_API_KEY=

# Comma-separated recipients. Defaults to Info@tencapital.group.
REPORT_EMAIL_TO=Info@tencapital.group

# Must use a domain verified at https://resend.com/domains.
REPORT_EMAIL_FROM=TEN Capital Deck Analyzer <deck-analyzer@tencapital.group>

# Set to 0 to switch notifications off without removing the key.
EMAIL_NOTIFICATIONS=1

# Optional tuning.
MAX_UPLOAD_MB=50
JOB_TTL_MINUTES=60
MAX_CONCURRENT_ANALYSES=2
DATA_DIR=
